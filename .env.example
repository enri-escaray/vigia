# Copie este archivo como .env (junto a config.yaml) y complete los valores.
# config.yaml los usa con ${NOMBRE}.

# Telegram: cree un bot con @BotFather y obtenga su chat_id con @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook (Slack, Discord, n8n, Home Assistant...)
VIGIA_WEBHOOK_URL=

# Correo (en Gmail use una "contraseña de aplicación")
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_DESTINO=

# Credenciales de cámaras IP
CAM_USUARIO=
CAM_CLAVE=
